# ResearchVault Root Environment Reference
PROJECT_NAME=ResearchVault
API_V1_STR=/api
SECRET_KEY=change_this_to_a_secure_random_key_in_production_min_32_characters
DATABASE_URL=sqlite:///./researchvault.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/researchvault

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=52428800
CHROMA_PERSIST_DIRECTORY=chroma_db
CHROMA_COLLECTION_NAME=research_vault_chunks
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
